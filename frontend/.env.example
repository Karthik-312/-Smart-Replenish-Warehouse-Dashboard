VITE_API_BASE_URL=http://localhost:8080/api/inventory

# Cloudinary — unsigned browser uploads for product photos.
# Both values are public by design; the upload preset must be set to Unsigned.
# If these are absent the manual-entry form falls back to a plain URL field.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
